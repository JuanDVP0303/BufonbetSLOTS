# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/igaming_slot

# Broker/cache para Celery (segundo plano)
REDIS_URL=redis://localhost:6379/0

# URL pública del iframe del juego (embed). En producción, tu dominio del frontend.
# Ej.: https://juegos.tudominio.com/embed
EMBED_BASE_URL=http://localhost:5174/embed
