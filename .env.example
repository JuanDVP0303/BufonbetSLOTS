# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/igaming_slot

# Broker/cache para Celery (segundo plano)
REDIS_URL=redis://localhost:6379/0

# Base del iframe del juego (embed). Dos formas:
#  - RUTA RELATIVA (recomendado si el frontend se sirve en el MISMO origen que la API):
#    el launch la resuelve contra el host:puerto de la petición → sale del mismo sitio
#    donde esté montada la app, sin hardcodear puerto. Ej.: /embed
#  - URL ABSOLUTA si el frontend vive en otro host. Ej.: https://juegos.tudominio.com/embed
EMBED_BASE_URL=/embed

# Detrás de un proxy/gateway (p. ej. Nginx en :8080 -> gunicorn): que Django reconstruya
# el host:puerto PÚBLICO desde las cabeceras reenviadas, para que thumbnails y embed salgan
# del mismo sitio donde se llega a la app (dinámico, sin hardcodear el puerto). En el
# SERVIDOR pon ambas a true (y asegúrate de que el gateway reenvía X-Forwarded-Host y
# X-Forwarded-Port). En local, false.
USE_X_FORWARDED_HOST=false
USE_X_FORWARDED_PORT=false

# Override OPCIONAL: base absoluta (esquema+host[:puerto]) para las URLs de media que
# consume el operador. SOLO si tu gateway no puede reenviar el puerto. Vacío = usa el
# mecanismo dinámico de arriba. Ej.: http://mi-host:8080
PUBLIC_BASE_URL=

# CORS: dominios de operadores autorizados a llamar la API desde el navegador
# (el casino que incrusta el iframe). Separados por coma. Vacío en dev.
# Ej.: https://casino-del-operador.com
DJANGO_CORS_ALLOWED_ORIGINS=
