# Copia a .env.local y ajusta. En desarrollo, deja VITE_API_BASE vacío para usar
# el proxy de Vite (/api -> Django en :8010).

# Base de la API. Vacío = mismo origen (proxy). En iframe/prod: https://tu-backend.
VITE_API_BASE=

# ID de la GameSession demo (lo imprime `python manage.py seed_demo_game`).
VITE_GAME_SESSION=4bb71dba-18a7-4d2b-af8f-95e3eb87ba08

# Apuesta por tiro, en unidades menores (céntimos).
VITE_BET_AMOUNT=100
